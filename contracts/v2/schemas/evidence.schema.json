{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rogue-shadowdancer/codex-hyperv-clean-room-plugin/contracts/v2/schemas/evidence.schema.json",
  "title": "Hyper-V clean-room schema-v2 automation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "createdAt",
    "profile",
    "candidate",
    "runtime",
    "baselineType",
    "vm",
    "guest",
    "artifacts",
    "automation",
    "powerOperations",
    "networkOperations",
    "networkRecovery",
    "automaticAssertions",
    "manualAssertions",
    "cleanupTriggered",
    "cleanupResults",
    "machineStatus",
    "overallStatus",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "operationId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "schemaVersion": { "const": 2 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fixtureIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "evidenceKind": { "const": "externalPortable" },
    "candidate": { "$ref": "#/$defs/candidateIdentity" },
    "runtime": { "$ref": "#/$defs/runtimeIdentity" },
    "baselineType": {
      "enum": ["stock-clean", "webview2-absent-derived"]
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "checkpointId",
        "checkpointName",
        "ownershipId",
        "ownershipVerified",
        "fingerprint"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "checkpointId": { "type": ["string", "null"], "maxLength": 256 },
        "checkpointName": { "type": ["string", "null"], "maxLength": 100 },
        "ownershipId": { "type": "string", "format": "uuid" },
        "ownershipVerified": { "type": "boolean" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "guest": { "$ref": "#/$defs/guestIdentity" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/artifactIdentity" }
    },
    "fixtureIdentities": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/externalFixtureIdentity" }
    },
    "automation": { "$ref": "#/$defs/automationIdentity" },
    "powerOperations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/powerOperation" }
    },
    "networkOperations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/networkOperation" }
    },
    "networkRecovery": { "$ref": "#/$defs/networkRecovery" },
    "automaticAssertions": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/automaticAssertion" }
    },
    "manualAssertions": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/manualAssertion" }
    },
    "cleanupTriggered": { "type": "boolean" },
    "cleanupResults": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/cleanupResult" }
    },
    "machineStatus": { "$ref": "#/$defs/machineStatus" },
    "overallStatus": { "$ref": "#/$defs/overallStatus" },
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 1000 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "machineStatus": { "const": "passed" } },
        "required": ["machineStatus"]
      },
      "then": {
        "properties": {
          "vm": {
            "properties": { "ownershipVerified": { "const": true } }
          },
          "guest": {
            "properties": {
              "isAdministrator": { "const": false },
              "isElevated": { "const": false },
              "tokenIntegrity": { "const": "medium" }
            }
          },
          "automation": {
            "properties": {
              "dataPreserved": { "const": true },
              "loopbackOnly": { "const": true }
            }
          },
          "artifacts": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/artifactIdentity" },
                { "properties": { "status": { "const": "passed" } } }
              ]
            }
          },
          "fixtureIdentities": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/externalFixtureIdentity" },
                { "properties": { "status": { "const": "passed" } } }
              ]
            }
          },
          "powerOperations": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/powerOperation" },
                { "properties": { "status": { "const": "passed" } } }
              ]
            }
          },
          "networkOperations": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/networkOperation" },
                { "properties": { "status": { "const": "passed" } } }
              ]
            }
          },
          "automaticAssertions": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/automaticAssertion" },
                {
                  "if": {
                    "properties": { "required": { "const": true } },
                    "required": ["required"]
                  },
                  "then": { "properties": { "status": { "const": "passed" } } }
                }
              ]
            }
          },
          "networkRecovery": {
            "if": {
              "properties": { "required": { "const": true } },
              "required": ["required"]
            },
            "then": { "properties": { "status": { "const": "passed" } } }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            { "not": { "required": ["evidenceKind"] } },
            { "not": { "required": ["fixtureIdentities"] } }
          ],
          "properties": {
            "profile": { "not": { "required": ["fixtureIds"] } },
            "candidate": { "$ref": "#/$defs/embeddedCandidateIdentity" },
            "runtime": { "$ref": "#/$defs/embeddedRuntimeIdentity" },
            "guest": { "$ref": "#/$defs/embeddedGuestIdentity" },
            "automation": { "$ref": "#/$defs/embeddedAutomationIdentity" }
          }
        },
        {
          "required": ["evidenceKind", "fixtureIdentities"],
          "properties": {
            "evidenceKind": { "const": "externalPortable" },
            "profile": { "required": ["fixtureIds"] },
            "candidate": { "$ref": "#/$defs/externalCandidateIdentity" },
            "runtime": { "$ref": "#/$defs/externalRuntimeIdentity" },
            "guest": { "$ref": "#/$defs/externalGuestIdentity" },
            "automation": { "$ref": "#/$defs/externalAutomationIdentity" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*:)(?!.*%)(?!.*[\\u0000-\\u001F])(?!(?:.*[\\\\/])?(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM](?:[1-9]|[¹²³])|[lL][pP][tT](?:[1-9]|[¹²³])|[cC][oO][nN](?:[iI][nN]|[oO][uU][tT])\\$)(?:\\.[^\\\\/]*)?(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[. ](?:[\\\\/]|$)).+$"
    },
    "safeZipLeaf": {
      "type": "string",
      "minLength": 5,
      "maxLength": 260,
      "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM](?:[1-9]|[¹²³])|[lL][pP][tT](?:[1-9]|[¹²³])|[cC][oO][nN](?:[iI][nN]|[oO][uU][tT])\\$)(?:\\.|$))(?!.*[\\u0000-\\u001F<>:\"|?*%])[^\\\\/]+\\.[zZ][iI][pP]$"
    },
    "status": {
      "enum": ["passed", "failed", "notPerformed", "unsupported"]
    },
    "machineStatus": { "enum": ["passed", "failed"] },
    "overallStatus": { "enum": ["passed", "failed", "incomplete"] },
    "candidateIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/embeddedCandidateIdentity" },
        { "$ref": "#/$defs/externalCandidateIdentity" }
      ]
    },
    "embeddedCandidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "portableZipSha256",
        "profileSha256",
        "fixtureSetSha256",
        "webDriverManifestSha256"
      ],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "portableZipSha256": { "$ref": "#/$defs/sha256" },
        "profileSha256": { "$ref": "#/$defs/sha256" },
        "fixtureSetSha256": { "$ref": "#/$defs/sha256" },
        "webDriverManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "externalCandidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "runtimeSourceCommit",
        "runtimeSourceTree",
        "packagingCommit",
        "packagingTree",
        "portableZipFileName",
        "portableZipSizeBytes",
        "portableZipSha256",
        "portableZipSourceSha256",
        "portableZipGuestSha256",
        "profileSha256",
        "requiredDistributionBoundary",
        "portableManifestDistributionBoundary",
        "portableManifestSource",
        "portableManifestRelativePath",
        "portableManifestSizeBytes",
        "portableManifestSourceSizeBytes",
        "portableManifestGuestSizeBytes",
        "portableManifestSha256",
        "portableManifestSourceSha256",
        "portableManifestGuestSha256",
        "portableInventoryFileCount",
        "portableInventorySizeBytes",
        "portableInventorySha256",
        "documentationSourceCommit",
        "documentationSourceTree",
        "documentationFileCount",
        "documentationPayloadSize",
        "documentationInventoryDigest",
        "oldRuntimeInventoryDigest",
        "newRuntimeInventoryDigest",
        "fixtureSetSha256",
        "webDriverManifestSha256"
      ],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/gitObject" },
        "runtimeSourceCommit": { "$ref": "#/$defs/gitObject" },
        "runtimeSourceTree": { "$ref": "#/$defs/gitObject" },
        "packagingCommit": { "$ref": "#/$defs/gitObject" },
        "packagingTree": { "$ref": "#/$defs/gitObject" },
        "portableZipFileName": { "$ref": "#/$defs/safeZipLeaf" },
        "portableZipSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "portableZipSha256": { "$ref": "#/$defs/sha256" },
        "portableZipSourceSha256": { "$ref": "#/$defs/sha256" },
        "portableZipGuestSha256": { "$ref": "#/$defs/sha256" },
        "profileSha256": { "$ref": "#/$defs/sha256" },
        "requiredDistributionBoundary": { "const": "end-user-complete" },
        "portableManifestDistributionBoundary": {
          "const": "end-user-complete"
        },
        "portableManifestSource": { "const": "externalProfileRelative" },
        "portableManifestRelativePath": { "$ref": "#/$defs/safeRelativePath" },
        "portableManifestSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "portableManifestSourceSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "portableManifestGuestSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "portableManifestSha256": { "$ref": "#/$defs/sha256" },
        "portableManifestSourceSha256": { "$ref": "#/$defs/sha256" },
        "portableManifestGuestSha256": { "$ref": "#/$defs/sha256" },
        "portableInventoryFileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "portableInventorySizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "portableInventorySha256": { "$ref": "#/$defs/sha256" },
        "documentationSourceCommit": { "$ref": "#/$defs/gitObject" },
        "documentationSourceTree": { "$ref": "#/$defs/gitObject" },
        "documentationFileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "documentationPayloadSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "documentationInventoryDigest": { "$ref": "#/$defs/sha256" },
        "oldRuntimeInventoryDigest": { "$ref": "#/$defs/sha256" },
        "newRuntimeInventoryDigest": { "$ref": "#/$defs/sha256" },
        "fixtureSetSha256": { "$ref": "#/$defs/sha256" },
        "webDriverManifestSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "runtimeIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/embeddedRuntimeIdentity" },
        { "$ref": "#/$defs/externalRuntimeIdentity" }
      ]
    },
    "embeddedRuntimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginVersion", "sourceCommit", "adapterMode"],
      "properties": {
        "pluginVersion": { "const": "0.2.0" },
        "sourceCommit": { "$ref": "#/$defs/gitObject" },
        "adapterMode": { "enum": ["mock", "production"] }
      }
    },
    "externalRuntimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginBaseVersion",
        "pluginBuildVersion",
        "sourceCommit",
        "installedInventorySha256",
        "adapterMode"
      ],
      "properties": {
        "pluginBaseVersion": { "const": "0.3.0" },
        "pluginBuildVersion": {
          "type": "string",
          "pattern": "^0\\.3\\.0\\+codex\\.[0-9]{14}$"
        },
        "sourceCommit": { "$ref": "#/$defs/gitObject" },
        "installedInventorySha256": { "$ref": "#/$defs/sha256" },
        "adapterMode": { "enum": ["mock", "production"] }
      }
    },
    "guestIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/embeddedGuestIdentity" },
        { "$ref": "#/$defs/externalGuestIdentity" }
      ]
    },
    "standardGuestIdentity": {
      "type": "object",
      "required": [
        "windowsBuild",
        "architecture",
        "userSid",
        "userName",
        "isAdministrator",
        "isElevated",
        "tokenIntegrity",
        "profilePathContainsNonAscii"
      ],
      "properties": {
        "windowsBuild": { "type": "string", "minLength": 1, "maxLength": 128 },
        "architecture": { "const": "x64" },
        "userSid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
        "userName": { "type": "string", "minLength": 1, "maxLength": 512 },
        "isAdministrator": { "type": "boolean" },
        "isElevated": { "type": "boolean" },
        "tokenIntegrity": {
          "enum": ["low", "medium", "mediumPlus", "high", "system"]
        },
        "profilePathContainsNonAscii": { "type": "boolean" }
      }
    },
    "embeddedGuestIdentity": {
      "allOf": [{ "$ref": "#/$defs/standardGuestIdentity" }],
      "unevaluatedProperties": false
    },
    "externalGuestIdentity": {
      "allOf": [
        { "$ref": "#/$defs/standardGuestIdentity" },
        {
          "required": ["orchestration"],
          "properties": {
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "userSid",
                "isAdministrator",
                "isElevated",
                "tokenIntegrity"
              ],
              "properties": {
                "userSid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
                "isAdministrator": { "const": true },
                "isElevated": { "const": true },
                "tokenIntegrity": { "enum": ["high", "system"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalFixtureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRelativePath",
        "profileSizeBytes",
        "sourceSizeBytes",
        "guestSizeBytes",
        "profileSha256",
        "sourceSha256",
        "guestSha256",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceRelativePath": { "$ref": "#/$defs/safeRelativePath" },
        "profileSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sourceSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "guestSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "profileSha256": { "$ref": "#/$defs/sha256" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "guestSha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "automationIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/embeddedAutomationIdentity" },
        { "$ref": "#/$defs/externalAutomationIdentity" }
      ]
    },
    "automationCommon": {
      "type": "object",
      "required": [
        "deploymentId",
        "deploymentFingerprint",
        "dataPreserved",
        "previousDataInventorySha256",
        "deployedDataInventorySha256",
        "webDriverManifestSha256",
        "fixedWebView2Version",
        "webDriverVersion",
        "loopbackOnly",
        "uiTrace"
      ],
      "properties": {
        "deploymentId": { "type": "string", "format": "uuid" },
        "deploymentFingerprint": { "$ref": "#/$defs/sha256" },
        "dataPreserved": { "type": "boolean" },
        "previousDataInventorySha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "deployedDataInventorySha256": { "$ref": "#/$defs/sha256" },
        "webDriverManifestSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "fixedWebView2Version": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            { "type": "null" }
          ]
        },
        "webDriverVersion": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            { "type": "null" }
          ]
        },
        "loopbackOnly": { "type": "boolean" },
        "uiTrace": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/uiTraceResult" }
        }
      }
    },
    "embeddedAutomationIdentity": {
      "allOf": [
        { "$ref": "#/$defs/automationCommon" },
        {
          "properties": {
            "webDriverManifestSha256": { "$ref": "#/$defs/sha256" },
            "fixedWebView2Version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "webDriverVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalAutomationIdentity": {
      "allOf": [
        { "$ref": "#/$defs/automationCommon" },
        {
          "required": ["deploymentSlotId", "entrypoint", "uiRequired"],
          "properties": {
            "deploymentSlotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "entrypoint": { "$ref": "#/$defs/safeRelativePath" },
            "uiRequired": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "uiRequired": { "const": true } },
                "required": ["uiRequired"]
              },
              "then": {
                "properties": {
                  "webDriverManifestSha256": { "$ref": "#/$defs/sha256" },
                  "fixedWebView2Version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "webDriverVersion": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
                  }
                }
              },
              "else": {
                "properties": {
                  "webDriverManifestSha256": { "type": "null" },
                  "fixedWebView2Version": { "type": "null" },
                  "webDriverVersion": { "type": "null" },
                  "uiTrace": { "maxItems": 0 }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "value": { "type": ["string", "number", "integer", "boolean", "null"], "maxLength": 2000 }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "id",
        "fileName",
        "sizeBytes",
        "sourceSha256",
        "guestSha256",
        "status"
      ],
      "properties": {
        "role": {
          "enum": [
            "portableZip",
            "portableManifest",
            "fixture",
            "webDriverArchive",
            "webDriverExecutable",
            "deployedPayload",
            "screenshot",
            "trace",
            "export"
          ]
        },
        "id": { "$ref": "#/$defs/id" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 8589934592 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "guestSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "uiTraceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "stepType", "testId", "status", "summary", "observations"],
      "properties": {
        "stepId": { "$ref": "#/$defs/id" },
        "stepType": {
          "enum": [
            "acquireWebDriver",
            "startUiSession",
            "stopUiSession",
            "uiClick",
            "uiSetText",
            "uiPressKey",
            "uiSelectOption",
            "uiUploadFixture",
            "assertUiElement",
            "captureUiScreenshot"
          ]
        },
        "testId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "maxLength": 2000 },
        "observations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "powerOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "planId",
        "action",
        "fromState",
        "toState",
        "beforeFingerprint",
        "afterFingerprint",
        "effectState",
        "status"
      ],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "planId": { "type": "string", "format": "uuid" },
        "action": { "enum": ["start", "gracefulShutdown"] },
        "fromState": { "enum": ["Off", "Running"] },
        "toState": { "enum": ["Off", "Running"] },
        "beforeFingerprint": { "$ref": "#/$defs/sha256" },
        "afterFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "effectState": { "enum": ["none", "confirmed", "indeterminate"] },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        { "$ref": "#/$defs/appliedOperationStatus" },
        {
          "oneOf": [
            {
              "properties": {
                "action": { "const": "start" },
                "fromState": { "const": "Off" },
                "toState": { "const": "Running" }
              }
            },
            {
              "properties": {
                "action": { "const": "gracefulShutdown" },
                "fromState": { "const": "Running" },
                "toState": { "const": "Off" }
              }
            }
          ]
        }
      ]
    },
    "networkOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "planId",
        "planRole",
        "target",
        "beforeFingerprint",
        "afterFingerprint",
        "effectState",
        "status"
      ],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "planId": { "type": "string", "format": "uuid" },
        "planRole": { "enum": ["change", "recovery"] },
        "target": { "enum": ["baseline", "disconnected"] },
        "beforeFingerprint": { "$ref": "#/$defs/sha256" },
        "afterFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "effectState": { "enum": ["none", "confirmed", "indeterminate"] },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [{ "$ref": "#/$defs/appliedOperationStatus" }]
    },
    "appliedOperationStatus": {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "afterFingerprint": { "$ref": "#/$defs/sha256" },
          "effectState": { "const": "confirmed" }
        }
      },
      "else": {
        "properties": {
          "effectState": { "enum": ["none", "indeterminate"] }
        }
      }
    },
    "networkRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "changePlanId",
        "recoveryPlanId",
        "recoveryOperationId",
        "status",
        "initialFingerprint",
        "finalFingerprint"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "changePlanId": { "type": ["string", "null"], "format": "uuid" },
        "recoveryPlanId": { "type": ["string", "null"], "format": "uuid" },
        "recoveryOperationId": { "type": ["string", "null"], "format": "uuid" },
        "status": { "$ref": "#/$defs/status" },
        "initialFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "finalFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "required": { "const": false },
            "changePlanId": { "type": "null" },
            "recoveryPlanId": { "type": "null" },
            "recoveryOperationId": { "type": "null" },
            "status": { "const": "notPerformed" },
            "initialFingerprint": { "type": "null" },
            "finalFingerprint": { "type": "null" }
          }
        },
        {
          "properties": {
            "required": { "const": true },
            "changePlanId": { "type": "string", "format": "uuid" },
            "recoveryPlanId": { "type": "string", "format": "uuid" },
            "initialFingerprint": { "$ref": "#/$defs/sha256" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "passed" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "recoveryOperationId": { "type": "string", "format": "uuid" },
                  "finalFingerprint": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          ]
        }
      ]
    },
    "automaticAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "status", "summary", "observations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "maxLength": 2000 },
        "observations": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "manualAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "description", "status", "attestation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "$ref": "#/$defs/status" },
        "attestation": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attestation" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "notPerformed" },
            "attestation": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["passed", "failed"] },
            "attestation": {
              "allOf": [
                { "$ref": "#/$defs/attestation" },
                {
                  "properties": {
                    "method": {
                      "enum": ["visualInspection", "interactiveExercise", "externalTool"]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "status": { "const": "unsupported" },
            "attestation": {
              "allOf": [
                { "$ref": "#/$defs/attestation" },
                { "properties": { "method": { "const": "declaredUnsupported" } } }
              ]
            }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "profileId",
        "assertionId",
        "observer",
        "observedAt",
        "method",
        "summary",
        "candidate",
        "evidenceReferences"
      ],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "profileId": { "$ref": "#/$defs/id" },
        "assertionId": { "$ref": "#/$defs/id" },
        "observer": { "type": "string", "minLength": 1, "maxLength": 512 },
        "observedAt": { "type": "string", "format": "date-time" },
        "method": {
          "enum": [
            "visualInspection",
            "interactiveExercise",
            "externalTool",
            "declaredUnsupported"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "candidate": { "$ref": "#/$defs/candidateIdentity" },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cleanupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "profileId",
        "cleanupStepId",
        "cleanupStepType",
        "status",
        "summary",
        "observations"
      ],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "profileId": { "$ref": "#/$defs/id" },
        "cleanupStepId": { "$ref": "#/$defs/id" },
        "cleanupStepType": {
          "enum": [
            "stopApplication",
            "stopUiSession",
            "captureUiScreenshot",
            "wait",
            "assertFile",
            "assertRegistry",
            "assertProcess",
            "assertModule",
            "assertShortcut",
            "assertPort",
            "assertSentinel"
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "maxLength": 2000 },
        "observations": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    }
  }
}
