{
  "mcpServers": {
    "hyperv-clean-room": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./mcp/server.ps1"
      ],
      "cwd": ".",
      "env_vars": [
        "COMPUTERNAME"
      ]
    }
  }
}
